# ── HubSpot — captura de leads ────────────────────────────────────────────
# Portal ID (mesmo da calculadora-saude)
HUBSPOT_PORTAL_ID=51315986

# Form GUID — você cria o formulário "Calculadora Oficinas" manualmente
# (HubSpot Free não permite criar form via API; só Marketing Hub Pro)
HUBSPOT_FORM_GUID=

# Token Private App — APENAS pra rodar `npm run setup:hubspot`
# Gera em: HubSpot → Configurações → Integrações → Apps privados
# Escopos necessários: crm.schemas.contacts.write + crm.objects.contacts.read
# Pode revogar/deletar o app depois que rodar o script (uso pontual)
HUBSPOT_PRIVATE_APP_TOKEN=

# ── Meta Pixel ────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=1750106205658482
META_PIXEL_ID=1750106205658482
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
